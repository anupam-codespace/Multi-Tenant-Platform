# Server Configuration
HOST=localhost
PORT=8080
ENV=dev

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_DB=ecommerce_platform
PG_USER=postgres
PG_PASSWORD=postgres
PG_SSL_MODE=disable

# Authentication
JWT_SECRET=instamart_super_secret_jwt_key_2026_dev_mode

# Admin Defaults
ADMIN_DEFAULT_EMAIL=admin@instamart.io
ADMIN_DEFAULT_PASSWORD=AdminSecurePassword2026!
ADMIN_ROLE=Admin

# OAuth (Optional)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Redis Configuration (For High-Concurrency Stock Reservation & Idempotency)
REDIS_HOST=localhost
REDIS_PORT=6379

# Agentic AI Integration (OpenAI / Gemini / Anthropic API Key)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
